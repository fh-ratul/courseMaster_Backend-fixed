# Backend Environment Variables

# Server
PORT=5000
NODE_ENV=development

# Database (required)
MONGODB_URI=mongodb://localhost:27017/coursemaster

# JWT (required)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin registration key (optional) - users who provide this key at sign-up become admins
ADMIN_REGISTRATION_KEY=your-secret-admin-key-here

# Seeder (optional) - email used for the seeded admin account
ADMIN_EMAIL=admin@coursemaster.com

# Email (optional) - welcome emails
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
FRONTEND_URL=http://localhost:5173
